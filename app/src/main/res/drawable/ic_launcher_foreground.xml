<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield + magnifier: "inspect before you open".
         Glyph scaled to 75% and centered (pivot 54,54 => translate 13.5). -->
    <group
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:translateX="13.5"
        android:translateY="13.5">

        <!-- Shield outline -->
        <path
            android:strokeColor="#22C55E"
            android:strokeWidth="5.5"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M 54,26 C 62,30.5 70,33 78,34 L 78,52 C 78,67.5 68.5,78 54,84 C 39.5,78 30,67.5 30,52 L 30,34 C 38,33 46,30.5 54,26 Z" />

        <!-- Magnifier lens -->
        <path
            android:strokeColor="#22C55E"
            android:strokeWidth="5"
            android:fillColor="#00000000"
            android:pathData="M 49,41 a 10.5,10.5 0 1,0 0,21 a 10.5,10.5 0 1,0 0,-21" />

        <!-- Magnifier handle -->
        <path
            android:strokeColor="#22C55E"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:pathData="M 56.5,58.5 L 65,67" />

        <!-- Link glyph inside the lens (chain link) -->
        <path
            android:strokeColor="#22C55E"
            android:strokeWidth="3.2"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M 45.5,51.5 a 3.4,3.4 0 1,0 4.8,-4.8 L 47.5,44 a 3.4,3.4 0 1,0 -4.8,4.8 Z M 52.5,49 a 3.4,3.4 0 1,0 4.8,4.8 l 2.2,-2.2 a 3.4,3.4 0 1,0 -4.8,-4.8 Z" />
    </group>
</vector>
